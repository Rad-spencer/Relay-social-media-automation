PORT=3000
# Keep loopback for a same-host reverse proxy. Managed container hosts may need 0.0.0.0.
HOST=127.0.0.1
APP_URL=http://localhost:3000
# Blank uses embedded PostgreSQL in .data; use PostgreSQL for deployment.
DATABASE_URL=
# Server-only private schema for hosted PostgreSQL/Supabase. Local PGlite ignores this.
DATABASE_SCHEMA=relay
# Optional trusted CA certificate from Supabase SSL settings; encode newlines as \n.
DATABASE_SSL_CA=
# Set false to disable creation of simulated workspaces.
ALLOW_DEMO=true
# Required to enable the signed internal event-ingestion endpoint (32+ random characters).
INGESTION_SECRET=

# Social login: configure registered provider apps; never use VITE_ for secrets.
# A persistent 32-byte hex key. Generate locally: openssl rand -hex 32
OAUTH_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Set an API version enabled for your Meta app, in vNN.N format.
META_GRAPH_VERSION=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
# TikTok calls its client ID the Client Key.
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
# LinkedIn publishing API version; update with a supported provider release.
LINKEDIN_API_VERSION=202604
